  "version": "1.1.0",
  "skills": [
    {
      "name": "prd-writer",
      "path": "skills/prd-writer/SKILL.md"
    },
    {
      "name": "tdd-writer",
      "path": "skills/tdd-writer/SKILL.md"
    },
    {
      "name": "ac-checker",
      "path": "skills/ac-checker/SKILL.md"
    }
  ],
  "commands": [
    {
      "name": "prd",
      "path": "commands/prd.md"
    },
    {
      "name": "tdd",
      "path": "commands/tdd.md"
    },
    {
      "name": "check-ac",
      "path": "commands/check-ac.md"
    }
  ]
}
